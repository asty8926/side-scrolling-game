; Engine configuration file.
; Pinned to Godot 4.7.2-stable (see AGENTS.md and docs/decisions/0001-engine-godot.md).
; Edit through Project > Project Settings, or by hand (agents), keeping the [debug] block intact.

config_version=5

[application]

config/name="side-scrolling-game"
config/description="Elsword-inspired 2.5D action brawler (open source)."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inference_on_variant=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_local_constant=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/unreachable_code=2
gdscript/warnings/integer_division=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
